<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_viz</name>
  <version>0.1.0</version>
  <description>
    RViz2 visualization for the G1 U6 VLA system from any PC on the robot LAN:
    joint-state relay (BODY-41 vector to URDF joint names), odom TF broadcaster,
    robot_state_publisher + RViz launch with a ready-made config.
  </description>
  <maintainer email="v.belcamino@fusionailabs.it">Valerio Belcamino</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>g1_action</depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>g1_description</exec_depend>
  <exec_depend>g1_unitree_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
