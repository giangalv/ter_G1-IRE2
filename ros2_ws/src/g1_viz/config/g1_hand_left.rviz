Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1
      Splitter Ratio: 0.5
    Tree Height: 500
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 20
      Cell Size: 0.5
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Marker Scale: 0.2
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Value: false
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /robot_description
      TF Prefix: ""
      Visual Enabled: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Tactile left
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /g1/viz/tactile/left
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Tactile right
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /g1/viz/tactile/right
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: LiDAR (Livox MID-360)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /utlidar/cloud_livox_mid360
      Size (m): 0.02
      Style: Flat Squares
      Color Transformer: AxisColor
      Axis: Z
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Head camera (D435i)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /g1/camera/color/image
      Normalize Range: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: D435i depth cloud
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /g1/camera/depth/points
      Size (m): 0.012
      Style: Flat Squares
      Color Transformer: AxisColor
      Axis: Z
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: D435i depth image
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /g1/camera/depth/image
      Normalize Range: false
      Min Value: 0.2
      Max Value: 4
      Value: true
  Global Options:
    Background Color: 35; 38; 41
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.32
      Target Frame: left_palm_force_sensor
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.9
      Yaw: 3.1
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
