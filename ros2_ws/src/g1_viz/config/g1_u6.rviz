Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1
        - /LiDAR1
      Splitter Ratio: 0.5
    Tree Height: 500
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 20
      Cell Size: 0.5
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.4
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /robot_description
      TF Prefix: ""
      Visual Enabled: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: LiDAR
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /g1/lidar/points
      Size (m): 0.02
      Style: Flat Squares
      Color Transformer: AxisColor
      Axis: Z
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera RGB
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /g1/camera/color/image
      Normalize Range: true
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Tracked Mask
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /g1/perception/tracked_mask
      Normalize Range: true
      Value: false
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: DynaMem Obstacles
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /g1/memory/dynamem/obstacle_map
      Color Scheme: map
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /g1/odom
      Keep: 100
      Shape:
        Alpha: 1
        Axes Length: 0.2
        Axes Radius: 0.02
        Value: Axes
      Value: true
  Global Options:
    Background Color: 35; 38; 41
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0.8
      Name: Current View
      Pitch: 0.4
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
